<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0C0A08">
    <ImageView
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/kvg_master_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Logo KVG Master Guadeloupe"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="KVG Master Guadeloupe"
        android:textColor="#E9CB82"
        android:textSize="23sp"
        android:textStyle="bold"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:text="Accès privé Google · Compte propriétaire"
        android:textColor="#B3AFA4"
        android:textSize="13sp"/>
    <Button
        android:id="@+id/open_kvg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Ouvrir KVG Master"
        android:textAllCaps="false"
        android:textSize="16sp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="La connexion Google utilise le navigateur sécurisé du téléphone. La barre du domaine se replie pendant la lecture."
        android:textColor="#938E84"
        android:textSize="11sp"/>
</LinearLayout>