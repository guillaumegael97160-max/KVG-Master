<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090806">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:paddingStart="3dp"
        android:paddingEnd="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#130F0A">
        <TextView
            android:id="@+id/inner_back"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textSize="28sp"
            android:textColor="#F2D797"
            android:contentDescription="Retour dans KVG Master"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="KVG · Page intégrée"
            android:textColor="#E5C470"
            android:textSize="12sp"
            android:singleLine="true"/>
        <TextView
            android:id="@+id/inner_reload"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="↻"
            android:textSize="24sp"
            android:textColor="#F2D797"
            android:contentDescription="Actualiser"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/inner_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone"
        android:progressTint="#DAB763"/>
    <WebView
        android:id="@+id/inner_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#090806"/>
</LinearLayout>